+bool Fuzzer::Stalled() {
+  if (StallReported)
+    return true;
+  if (!StallTimersStarted || (!Options.NewStallSec && !Options.CovStallSec))
+    return false;
+  const auto Now = steady_clock::now();
+  const bool NewExpired = Options.NewStallSec > 0 &&
+      Now - LastNewTime >= seconds(Options.NewStallSec);
+  const bool CovExpired = Options.CovStallSec > 0 &&
+      Now - LastCovTime >= seconds(Options.CovStallSec);
+  if (!NewExpired && !CovExpired)
+    return false;
+  if (NewExpired)
+    Printf("INFO: --new-stall=%d reached: no NEW for %lld seconds\n",
+           Options.NewStallSec,
+           static_cast<long long>(duration_cast<seconds>(Now - LastNewTime).count()));
+  if (CovExpired)
+    Printf("INFO: --cov-stall=%d reached: no cov increase for %lld seconds (cov: %zd)\n",
+           Options.CovStallSec,
+           static_cast<long long>(duration_cast<seconds>(Now - LastCovTime).count()),
+           StallCoverage);
+  StallReported = true;
+  return true;
+}
